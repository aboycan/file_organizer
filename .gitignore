# File Organizer - files Git should not track: Python bytecode, run logs,
# PyInstaller build output, OS cruft and virtual environments.
# Author: Madhu Kumar <madhu.a@hotmail.com>

__pycache__/
*.pyc

# Runtime output (created by running the tool, not part of the source)
logs/

# PyInstaller build output
build/
dist/
*.spec

# OS cruft
.DS_Store
Thumbs.db

# Virtual environments
.venv/
venv/
